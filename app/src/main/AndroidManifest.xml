<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".LifeClockApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MementoMori">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M0 spike (T0.4) only: measurement probe for Doze/alarm cadence.
             exported=true so `adb shell am broadcast` can trigger it. Delete before M2. -->
        <receiver
            android:name=".spike.SpikeProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.mementomori.lifeclock.spike.SCHEDULE" />
                <action android:name="dev.mementomori.lifeclock.spike.INEXACT" />
                <action android:name="dev.mementomori.lifeclock.spike.EXACT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
