<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to receive ACTION_BOOT_COMPLETED at all. It is a normal permission, so it is
         granted at install time and needs no runtime request. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Library manifests are MERGED into the app manifest at build time.
         Declaring the widget receiver here keeps the widget self-contained. -->
    <application>

        <!-- Everything that means "the widget may now be wrong": boot, a clock or timezone
             change, a date rollover, an app upgrade, and the boundary alarm (an explicit intent,
             which is delivered even though exported=false).
             exported=false is safe because these are system broadcasts and the system is allowed
             to reach a non-exported receiver; no other app can.
             This receiver only enqueues WorkManager work - it never draws (see M0 findings §6). -->
        <receiver
            android:name="dev.mementomori.lifeclock.widget.refresh.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The widget itself. exported=true is required: the launcher is a different process and
             must be able to send APPWIDGET_UPDATE. -->
        <receiver
            android:name="dev.mementomori.lifeclock.widget.CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label"
            android:configure="dev.mementomori.lifeclock.widget.config.ConfigActivity"
            android:widgetFeatures="reconfigurable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Glance's debug trigger, which (unlike APPWIDGET_UPDATE) is a normal action we
                     may send over adb:
                     adb shell am broadcast -a androidx.glance.appwidget.action.DEBUG_UPDATE -n ...
                     TODO(M5): strip before release. -->
                <action android:name="androidx.glance.appwidget.action.DEBUG_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <!-- The picker. The launcher starts it after a placement and, because the receiver is
             `reconfigurable`, again when the user taps a placed widget.
             exported=true is required: the launcher runs in another process and starts it for us. -->
        <activity
            android:name="dev.mementomori.lifeclock.widget.config.ConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/config_picker_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
